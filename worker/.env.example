# Переменные окружения сервера уведомлений. Здесь только имена, без настоящих значений.
#
# На Cloudflare секреты задаются командой (значение вводится в терминале и в репозиторий не попадает):
#   npx wrangler secret put VAPID_PRIVATE_KEY
# Для локального запуска (npx wrangler dev) скопируйте этот файл в worker/.dev.vars
# и впишите значения. Файл .dev.vars в .gitignore.
#
# Открытые настройки (VAPID_PUBLIC, VAPID_SUBJECT, ALLOWED_ORIGINS, PUBLIC_URL) лежат
# в wrangler.toml в разделе [vars]: они не секретные.

# Закрытый ключ VAPID для отправки push (JWK, поле d). Создаётся scripts/generate-vapid.mjs.
VAPID_PRIVATE_KEY=

# Соль для хешей IP-адреса и номера устройства в отметках «Вижу сияние» и в статистике посещений.
# Любая длинная случайная строка, например из: node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
# Если её сменить, старые хеши перестанут совпадать с новыми (лимиты начнутся заново).
REPORT_SALT=

# Telegram-бот: токен от @BotFather и числовой id владельца (для оповещений мониторинга).
# Необязательно: без них бот и оповещения просто выключены.
TELEGRAM_TOKEN=
TELEGRAM_OWNER_CHAT=
